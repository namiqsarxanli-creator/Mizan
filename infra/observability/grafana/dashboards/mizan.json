{
  "uid": "mizan-overview",
  "title": "Mizan",
  "tags": [
    "mizan",
    "genai"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "trace_id",
        "label": "Trace id",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request latency p50 / p95 (API)",
      "description": "SLO: p95 < 8 s for /v1/agent/ask",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(Timestamp) AS time,\n       quantile(0.5)(Duration) / 1e6 AS p50_ms,\n       quantile(0.95)(Duration) / 1e6 AS p95_ms\nFROM otel.otel_traces\nWHERE $__timeFilter(Timestamp) AND SpanKind = 'Server' AND ServiceName = 'mizan-api'\nGROUP BY time ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "LLM cost (USD, estimate)",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(Timestamp) AS time,\n       SpanAttributes['gen_ai.request.model'] AS model,\n       sum(toFloat64OrZero(SpanAttributes['mizan.cost.usd'])) AS usd\nFROM otel.otel_traces\nWHERE $__timeFilter(Timestamp) AND SpanAttributes['gen_ai.operation.name'] = 'chat'\nGROUP BY time, model ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "type": "table",
      "title": "Tokens by model and prompt version",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT SpanAttributes['gen_ai.request.model'] AS model,\n       SpanAttributes['mizan.prompt.version'] AS prompt_version,\n       count() AS calls,\n       sum(toUInt64OrZero(SpanAttributes['gen_ai.usage.input_tokens'])) AS input_tokens,\n       sum(toUInt64OrZero(SpanAttributes['gen_ai.usage.output_tokens'])) AS output_tokens,\n       round(quantile(0.95)(Duration) / 1e6) AS p95_ms\nFROM otel.otel_traces\nWHERE $__timeFilter(Timestamp) AND SpanAttributes['gen_ai.operation.name'] = 'chat'\nGROUP BY model, prompt_version ORDER BY calls DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "type": "table",
      "title": "Agent outcomes",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT SpanAttributes['mizan.verdict'] AS verdict, count() AS runs,\n       round(avg(toFloat64OrZero(SpanAttributes['mizan.confidence'])), 3) AS mean_confidence\nFROM otel.otel_traces\nWHERE $__timeFilter(Timestamp) AND SpanName = 'invoke_agent orchestrator'\nGROUP BY verdict"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "type": "table",
      "title": "Errors and degradations by span",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT SpanName AS span,\n       countIf(StatusCode = 'Error') AS errors,\n       countIf(SpanAttributes['mizan.degraded'] = 'true') AS degraded,\n       count() AS total\nFROM otel.otel_traces\nWHERE $__timeFilter(Timestamp)\nGROUP BY span HAVING errors > 0 OR degraded > 0 ORDER BY errors DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "type": "table",
      "title": "Recent requests (trace explorer: click a trace id)",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT Timestamp AS time, TraceId AS trace_id, SpanName AS request,\n       round(Duration / 1e6) AS ms, StatusCode AS status\nFROM otel.otel_traces\nWHERE $__timeFilter(Timestamp) AND ParentSpanId = '' AND ServiceName = 'mizan-api'\nORDER BY Timestamp DESC LIMIT 100"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "trace_id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open trace",
                    "url": "/d/mizan-overview/mizan?var-trace_id=${__value.raw}&${__url_time_range}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {}
    },
    {
      "id": 7,
      "type": "traces",
      "title": "Trace ${trace_id}",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 3,
          "queryType": "traces",
          "rawSql": "SELECT TraceId AS traceID, SpanId AS spanID, ParentSpanId AS parentSpanID,\n       ServiceName AS serviceName, SpanName AS operationName,\n       toUnixTimestamp64Milli(Timestamp) AS startTime,\n       Duration / 1e6 AS duration,\n       arrayMap(k -> map('key', k, 'value', SpanAttributes[k]), mapKeys(SpanAttributes)) AS tags,\n       arrayMap(k -> map('key', k, 'value', ResourceAttributes[k]), mapKeys(ResourceAttributes))\n         AS serviceTags\nFROM otel.otel_traces\nWHERE TraceId = '${trace_id}'"
        }
      ]
    },
    {
      "id": 20,
      "type": "row",
      "title": "Quality and SLOs",
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 21,
      "type": "stat",
      "title": "Faithfulness, last 7 days (online eval)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 39,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT avg(faithfulness) AS faithfulness FROM online_evals WHERE created_at >= now() - interval '7 days'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.9
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 22,
      "type": "stat",
      "title": "User feedback 👍 share, last 7 days",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 6,
        "y": 39,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT avg((rating > 0)::int) AS thumbs_up FROM feedback WHERE created_at >= now() - interval '7 days'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 23,
      "type": "stat",
      "title": "Agent p95 latency (SLO < 8 s)",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 12,
        "y": 39,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT quantile(0.95)(Duration) / 1e6 AS p95_ms FROM otel.otel_traces\nWHERE $__timeFilter(Timestamp) AND SpanKind = 'Server' AND SpanName LIKE 'POST /v1/agent/ask%'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 24,
      "type": "stat",
      "title": "Availability (SLO 99.5%)",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 18,
        "y": 39,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT 1 - countIf(toUInt16OrZero(SpanAttributes['http.response.status_code']) >= 500)\n         / greatest(count(), 1) AS availability\nFROM otel.otel_traces WHERE $__timeFilter(Timestamp) AND SpanKind = 'Server'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 25,
      "type": "timeseries",
      "title": "Daily online faithfulness",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 45,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT date_trunc('day', created_at) AS time, avg(faithfulness) AS faithfulness, count(*) AS n FROM online_evals WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 26,
      "type": "table",
      "title": "Least faithful recent answers",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 45,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT a.created_at, a.endpoint, a.question, e.faithfulness, e.unsupported FROM online_evals e JOIN answers a ON a.id = e.answer_id WHERE $__timeFilter(e.created_at) ORDER BY e.faithfulness ASC LIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 27,
      "type": "table",
      "title": "Shadow candidates vs primary, last 7 days",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 53,
        "w": 16,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT s.candidate, a.model AS primary_model, count(*) AS requests,\n  round(avg(s.citation_overlap)::numeric, 3) AS citation_overlap,\n  round(avg(s.refusal_agrees::int)::numeric, 3) AS refusal_agreement,\n  percentile_cont(0.5) WITHIN GROUP (ORDER BY s.primary_latency_ms) AS primary_p50_ms,\n  percentile_cont(0.5) WITHIN GROUP (ORDER BY s.latency_ms) AS candidate_p50_ms,\n  round(avg(s.primary_tokens)) AS primary_tokens, round(avg(s.tokens)) AS candidate_tokens\nFROM shadow_runs s JOIN answers a ON a.id = s.answer_id\nWHERE s.created_at >= now() - interval '7 days'\nGROUP BY s.candidate, a.model ORDER BY requests DESC"
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 28,
      "type": "stat",
      "title": "Open human reviews",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 16,
        "y": 53,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT reason, count(*) AS open FROM reviews WHERE status = 'open' GROUP BY reason ORDER BY open DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": true
        },
        "textMode": "value_and_name"
      }
    }
  ]
}
