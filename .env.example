# Copy to .env for local development.  Never commit .env.
# Format: MIZAN_<SECTION>__<KEY>=value

MIZAN_ENVIRONMENT=local
MIZAN_LOG__LEVEL=INFO
MIZAN_LOG__JSON_FORMAT=false

# Optional: export traces to an OTLP/HTTP collector (e.g. Jaeger, Grafana Tempo).
# MIZAN_TELEMETRY__OTLP_ENDPOINT=http://localhost:4318
MIZAN_TELEMETRY__SAMPLE_RATIO=1.0

MIZAN_POSTGRES__HOST=127.0.0.1
MIZAN_POSTGRES__PORT=15432
MIZAN_POSTGRES__USER=mizan
MIZAN_POSTGRES__PASSWORD=mizan-dev-password
MIZAN_POSTGRES__DATABASE=mizan

MIZAN_REDIS__URL=redis://127.0.0.1:16379/0

MIZAN_QDRANT__URL=http://127.0.0.1:16333
# MIZAN_QDRANT__API_KEY=

MIZAN_NEO4J__URI=bolt://127.0.0.1:17687
MIZAN_NEO4J__USER=neo4j
MIZAN_NEO4J__PASSWORD=mizan-dev-password

# Host ports published by compose.yaml (the values below are the defaults).
# Change them if they clash with other services on your machine, and keep the
# connection settings above in sync.
# MIZAN_HOST_PORT_POSTGRES=15432
# MIZAN_HOST_PORT_REDIS=16379
# MIZAN_HOST_PORT_QDRANT=16333
# MIZAN_HOST_PORT_QDRANT_GRPC=16334
# MIZAN_HOST_PORT_NEO4J_HTTP=17474
# MIZAN_HOST_PORT_NEO4J_BOLT=17687
# MIZAN_HOST_PORT_API=18000

# Retrieval serving configuration (defaults = the variant chosen in ADR-0004).
# MIZAN_RETRIEVAL__MODE=dense            # dense | sparse | hybrid
# MIZAN_RETRIEVAL__DENSE_MODEL=bge-m3
# MIZAN_RETRIEVAL__SPARSE=bm25_p5
# MIZAN_RETRIEVAL__RERANK_TOP=0          # 20 = cross-encoder rerank (worth it on GPU only)

# Answer generation for POST /v1/ask (search works without it).
# Free key: https://console.groq.com/keys
MIZAN_LLM__PROVIDER=groq
MIZAN_LLM__GROQ_API_KEY=
# MIZAN_LLM__GROQ_MODEL=openai/gpt-oss-120b
# MIZAN_LLM__EFFORT=medium
# MIZAN_LLM__REWRITE_QUERIES=false
# Alternative: MIZAN_LLM__PROVIDER=anthropic and MIZAN_LLM__ANTHROPIC_API_KEY=...
